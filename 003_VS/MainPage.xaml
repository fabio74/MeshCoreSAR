<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MeshCoreTracker.MainPage"
             Title="MeshCore Tracker"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid RowDefinitions="*,Auto,Auto" ColumnDefinitions="360,*">
        <Border Grid.Row="0" Grid.Column="0"
                BackgroundColor="{StaticResource PanelBackground}">
            <ScrollView Orientation="Vertical"
                        VerticalScrollBarVisibility="Always"
                        HorizontalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="12,12,18,12" Spacing="8">
                    <Label Text="MESHCORE USB" Style="{StaticResource SectionTitleLabelStyle}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <Picker x:Name="PortPicker" Grid.Column="0" Title="Porta seriale" />
                        <Button Grid.Column="1" Text="Aggiorna" Clicked="OnRefreshPortsClicked" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button x:Name="ConnectButton" Grid.Column="0" Text="Connetti" Clicked="OnConnectClicked" />
                        <Button x:Name="DisconnectButton" Grid.Column="1" Text="Disconnetti" IsEnabled="False" Clicked="OnDisconnectClicked" />
                    </Grid>

                    <Label x:Name="UsbStatusLabel" Text="Non connesso" FontAttributes="Italic" TextColor="{StaticResource TextPrimaryColor}" />

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,5" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                        <Label Grid.Column="0" Text="CONTATTI DA INTERROGARE" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource TextPrimaryColor}" />
                        <Button Grid.Column="1" Text="Tutti" Style="{StaticResource SmallActionButtonStyle}" Clicked="OnSelectAllPollClicked" />
                        <Button Grid.Column="2" Text="Nessuno" Style="{StaticResource SmallActionButtonStyle}" Clicked="OnSelectNonePollClicked" />
                    </Grid>
                    <VerticalStackLayout x:Name="ContactsPanel" Spacing="2" />

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,5" />

                    <Grid ColumnDefinitions="Auto,90,*" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="IntPing" VerticalOptions="Center" />
                        <Entry x:Name="IntPingEntry" Grid.Column="1" Text="15" Keyboard="Numeric" HorizontalTextAlignment="End" />
                        <Label Grid.Column="2" Text="secondi" VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button x:Name="StartButton" Grid.Column="0" Text="Avvia" Clicked="OnStartClicked" />
                        <Button x:Name="StopButton" Grid.Column="1" Text="Stop" IsEnabled="False" Clicked="OnStopClicked" />
                    </Grid>

                    <Button Text="Esporta tracce GPX" Clicked="OnExportGpxClicked" />

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,5" />

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                        <Label Grid.Column="0" Text="TRACCE VISIBILI" FontAttributes="Bold" VerticalOptions="Center" TextColor="{StaticResource TextPrimaryColor}" />
                        <Button Grid.Column="1" Text="Tutte" Style="{StaticResource SmallActionButtonStyle}" Clicked="OnShowAllTracksClicked" />
                        <Button Grid.Column="2" Text="Nessuna" Style="{StaticResource SmallActionButtonStyle}" Clicked="OnHideAllTracksClicked" />
                    </Grid>
                    <VerticalStackLayout x:Name="TracksPanel" Spacing="2" />

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,5" />

                    <Label Text="MAPPA" FontAttributes="Bold" TextColor="{StaticResource TextPrimaryColor}" />
                    <Picker x:Name="MapProviderPicker"
                            SelectedIndex="0"
                            SelectedIndexChanged="OnMapProviderChanged">
                        <Picker.Items>
                            <x:String>OpenStreetMap</x:String>
                            <x:String>OpenTopoMap</x:String>
                            <x:String>Esri Satellite</x:String>
                        </Picker.Items>
                    </Picker>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Button Grid.Column="0" Text="Carica GeoTIFF" Clicked="OnLoadGeoTiffClicked" />
                        <Button Grid.Column="1" Text="Adatta tracce" Clicked="OnFitTracksClicked" />
                    </Grid>

                    <Label Text="GeoTIFF offline: EPSG:4326, 3857, ED50/UTM 23032-23033 e WGS84/UTM 326xx-327xx." FontSize="11" Style="{StaticResource SubtleLabelStyle}" />
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <WebView x:Name="MapWebView" Source="map.html" Navigated="OnMapNavigated" />
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BackgroundColor="#F3F4F6" Padding="8,5">
            <Label x:Name="OperationStatusLabel" Text="Pronto." LineBreakMode="TailTruncation" TextColor="{StaticResource TextPrimaryColor}" />
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BackgroundColor="#E5E7EB" Padding="8,5">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
                <Label x:Name="CoordinatesLabel" Text="Coordinate dispositivi: —" LineBreakMode="NoWrap" TextColor="{StaticResource TextPrimaryColor}" />
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
